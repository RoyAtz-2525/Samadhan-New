DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

JWT_ACCESS_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------------------------
# Payment Gateways (Independent Test Modes & Credential Isolation)
# -------------------------------------------------------------
# Razorpay Standard Checkout (Citizen Payments)
RAZORPAY_CHECKOUT_TEST_MODE=true
RAZORPAY_KEY_ID=your_checkout_key_id
RAZORPAY_KEY_SECRET=your_checkout_key_secret
RAZORPAY_WEBHOOK_SECRET=your_checkout_webhook_secret

# RazorpayX Payouts (Worker Bank/UPI Disbursements)
# Safe default: remains in simulation mode unless explicitly set to 'false'
RAZORPAYX_PAYOUT_TEST_MODE=true
RAZORPAYX_KEY_ID=your_payout_key_id
RAZORPAYX_KEY_SECRET=your_payout_key_secret
RAZORPAYX_ACCOUNT_NUMBER=2323230000000000
RAZORPAYX_WEBHOOK_SECRET=your_payout_webhook_secret

# Legacy backwards-compatibility flag (optional)
PAYMENT_TEST_MODE=true

FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=production

# -------------------------------------------------------------
# Caching Layer (Upstash Redis REST - Recommended for Serverless/API)
# -------------------------------------------------------------
# Used by cacheService.js for high-speed API & dashboard caching via HTTP REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -------------------------------------------------------------
# BullMQ Background Job Infrastructure (Redis TCP/TLS Connection)
# -------------------------------------------------------------
# Required by BullMQ workers (media cleanup & delayed SLA milestone checks).
# BullMQ strictly requires the Redis TCP/TLS protocol (rediss:// or redis://),
# available from Upstash under "Connect -> Node.js / ioredis"
# or any hosted Redis provider (e.g. Redis Cloud, Railway, Render, Docker).
# If unconfigured, the API operates safely in database-only mode,
# and SLA milestones are tracked via PostgreSQL database reconciliation.
REDIS_URL=

# -------------------------------------------------------------
# Citizen Reward Points Configuration
# -------------------------------------------------------------
# Configurable point amounts awarded to citizens during workflow transitions
REWARD_POINTS_REPORT_APPROVED=10
REWARD_POINTS_ISSUE_RESOLVED=10
